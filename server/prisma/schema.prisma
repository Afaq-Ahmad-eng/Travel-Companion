generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  user_id            Int                 @id @default(autoincrement())
  user_name          String              @unique(map: "user_name") @db.VarChar(300)
  user_email         String              @unique(map: "user_email") @db.VarChar(300)
  user_phoneno       String              @db.VarChar(200)
  user_location      String              @db.VarChar(200)
  user_password      String              @db.VarChar(300)
  user_joined        DateTime            @default(now()) @db.Timestamp(0)
  user_updatedAt     DateTime            @default(now()) @db.Timestamp(0)
  user_status        user_user_status?   @default(active)
  is_logged_in       Boolean?            @default(false)
  complaint          complaint[]
  trips              trips[]
  user_refresh_token user_refresh_token?
}

model user_refresh_token {
  token_id      Int    @id @default(autoincrement())
  user_id       Int    @unique(map: "user_id")
  refresh_token String @db.VarChar(250)
  user          user   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_user_refresh_token_user_id")
}

model experience_images {
  id                Int               @id @default(autoincrement())
  experience_id     Int
  image_url         String            @db.Text
  share_experiences share_experiences @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade, onUpdate: Restrict, map: "experience_images_ibfk_1")

  @@index([experience_id], map: "experience_images_ibfk_1")
}

model share_experiences {
  experience_id     Int                 @id @default(autoincrement())
  trip_id           Int                 @unique(map: "trip_id")
  title             String              @unique(map: "unique_title") @db.VarChar(255)
  description       String              @db.Text
  blog              String?             @db.LongText
  rating            Decimal             @db.Decimal(2, 1)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamp(0)
  experience_images experience_images[]
  trips             trips               @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_experience_trip")
}

model budgets {
  budget_id         Int          @id @default(autoincrement())
  trip_id           Int          @unique(map: "trip_id")
  trip_budget_title String       @db.VarChar(150)
  total_amount      Decimal      @default(0.00) @db.Decimal(12, 2)
  created_at        DateTime     @default(now()) @db.Timestamp(0)
  updated_at        DateTime     @default(now()) @db.Timestamp(0)
  trips             trips        @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_budgets_trip")
  categories        categories[]
}

model categories {
  category_id      Int        @id @default(autoincrement())
  budget_id        Int
  category_name    String     @db.VarChar(100)
  allocated_amount Decimal?   @default(0.00) @db.Decimal(12, 2)
  created_at       DateTime   @default(now()) @db.Timestamp(0)
  updated_at       DateTime   @default(now()) @db.Timestamp(0)
  budgets          budgets    @relation(fields: [budget_id], references: [budget_id], onDelete: Cascade, map: "categories_ibfk_1")
  expenses         expenses[]

  @@index([budget_id], map: "budget_id")
}

model expenses {
  expense_id   Int        @id @default(autoincrement())
  category_id  Int
  description  String?    @db.VarChar(255)
  amount       Decimal    @db.Decimal(12, 2)
  expense_date DateTime   @db.Date
  created_at   DateTime   @default(now()) @db.Timestamp(0)
  updated_at   DateTime   @default(now()) @db.Timestamp(0)
  categories   categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade, map: "expenses_ibfk_1")

  @@index([category_id], map: "category_id")
}

model trips {
  trip_id           Int                @id @default(autoincrement())
  user_id           Int
  trip_title        String             @db.VarChar(255)
  destination       String             @db.VarChar(255)
  start_date        DateTime?          @db.DateTime(0)
  end_date          DateTime?          @db.DateTime(0)
  created_at        DateTime           @default(now()) @db.Timestamp(0)
  updated_at        DateTime           @default(now()) @db.Timestamp(0)
  isCanceled        Boolean?           @default(false)
  budgets           budgets?
  share_experiences share_experiences?
  trip_interests    trip_interests[]
  user              user               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_trips_user")

  @@index([user_id], map: "fk_trips_user")
}

model interest_areas {
  interest_id    Int              @id @default(autoincrement())
  interest_name  String           @db.VarChar(100)
  trip_interests trip_interests[]
}

model trip_interests {
  trip_id        Int
  interest_id    Int
  trips          trips          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: Restrict, map: "trip_interests_ibfk_1")
  interest_areas interest_areas @relation(fields: [interest_id], references: [interest_id], onDelete: Cascade, onUpdate: Restrict, map: "trip_interests_ibfk_2")

  @@id([trip_id, interest_id])
  @@index([interest_id], map: "interest_id")
}

model complaint {
  id          Int       @id @default(autoincrement())
  userId      Int
  subject     String    @db.VarChar(255)
  description String    @db.Text
  category    String?   @db.VarChar(100)
  fileUrl     String    @db.VarChar(255)
  createdAt   DateTime? @default(now()) @db.DateTime(0)
  isResolved  Boolean?  @default(false)
  updatedAt   DateTime? @default(now()) @db.DateTime(0)
  user        user      @relation(fields: [userId], references: [user_id], onUpdate: Restrict, map: "complaint_ibfk_1")

  @@index([userId], map: "userId")
}

model admin {
  admin_id            Int                  @id @default(autoincrement())
  admin_name          String               @db.VarChar(100)
  admin_email         String               @unique(map: "admin_email") @db.VarChar(100)
  admin_password      String               @db.VarChar(255)
  role                String?              @default("admin") @db.VarChar(50)
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  last_login          DateTime?            @db.Timestamp(0)
  is_active           Boolean?             @default(false)
  admin_phoneno       String?              @db.VarChar(350)
  admin_location      String?              @db.VarChar(150)
  admin_refresh_token admin_refresh_token?
}

model admin_refresh_token {
  id            Int    @id @default(autoincrement())
  admin_id      Int    @unique(map: "unique_admin_id")
  refresh_token String @db.Text
  admin         admin  @relation(fields: [admin_id], references: [admin_id], onDelete: Cascade, onUpdate: Restrict, map: "admin_refresh_token_ibfk_1")
}

enum user_user_status {
  active
  pending
}
